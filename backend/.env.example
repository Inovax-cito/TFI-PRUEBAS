PORT=5000
DATABASE_URL="mysql://usuario:contraseña@localhost:3306/sistema_autogestion"
JWT_SECRET="clave_secreta_jwt_para_firmar_tokens"
NODE_ENV=development
# Client ID de OAuth (tipo "Aplicación web") de Google Cloud Console. Vacío = ingreso con Google deshabilitado.
GOOGLE_CLIENT_ID=""
# Clave de Maps JavaScript API (restringida por dominio). Vacía = se usa el mapa de OpenStreetMap.
GOOGLE_MAPS_API_KEY=""
# Map ID (opcional) para marcadores avanzados. Vacío = DEMO_MAP_ID.
GOOGLE_MAPS_MAP_ID=""
