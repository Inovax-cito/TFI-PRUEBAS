datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMINISTRADOR
  EMPLEADO
  EMPRENDEDOR
}

enum MovementType {
  INGRESO_COMPRA
  SALIDA_VENTA
  AJUSTE_POSITIVO
  AJUSTE_NEGATIVO
  DEVOLUCION
}

enum PurchaseStatus {
  PENDIENTE
  RECIBIDA
  CANCELADA
}

enum SaleStatus {
  COMPLETADA
  CANCELADA
}

enum CashStatus {
  ABIERTA
  CERRADA
}

enum CashMovementType {
  INGRESO
  EGRESO
}

enum BusinessKind {
  FIJO
  ITINERANTE
}

enum OpportunityStatus {
  BORRADOR
  PUBLICADA
  CERRADA
}

enum ApplicationStatus {
  BORRADOR
  ENVIADA
  EN_REVISION
  APROBADA
  NO_SELECCIONADA
  CANCELADA
}

model User {
  id                 Int                 @id @default(autoincrement())
  name               String
  lastName           String
  username           String              @unique
  email              String              @unique
  password           String
  role               Role                @default(EMPLEADO)
  status             Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  sales              Sale[]
  purchases          Purchase[]
  inventoryMovements InventoryMovement[]
  priceHistories     PriceHistory[]
  cashMovements      CashMovement[]
  openedRegisters    CashRegister[]      @relation("OpenedRegisters")
  closedRegisters    CashRegister[]      @relation("ClosedRegisters")
  cancelledSales     Sale[]              @relation("CancelledSales")
  businessProfile    BusinessProfile?
  organizedEvents    MarketEvent[]        @relation("EventOrganizer")
  eventApplications EventApplication[]   @relation("Applicant")
  userNotifications Notification[]

  @@map("users")
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  active      Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())

  @@map("categories")
}

model Product {
  id                 Int                 @id @default(autoincrement())
  name               String
  description        String?             @db.Text
  sku                String              @unique
  categoryId         Int
  category           Category            @relation(fields: [categoryId], references: [id])
  purchasePrice      Decimal             @db.Decimal(12, 2)
  salePrice          Decimal             @db.Decimal(12, 2)
  currentStock       Int                 @default(0)
  minStock           Int                 @default(5)
  unit               String              @default("unidad")
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  saleDetails        SaleDetail[]
  purchaseDetails    PurchaseDetail[]
  inventoryMovements InventoryMovement[]
  priceHistory       PriceHistory[]

  @@map("products")
}

model PriceHistory {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  oldPrice  Decimal  @db.Decimal(12, 2)
  newPrice  Decimal  @db.Decimal(12, 2)
  changedAt DateTime @default(now())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])

  @@map("price_histories")
}

model InventoryMovement {
  id            Int          @id @default(autoincrement())
  productId     Int
  product       Product      @relation(fields: [productId], references: [id])
  type          MovementType
  quantity      Int
  previousStock Int
  resultStock   Int
  reason        String?
  userId        Int
  user          User         @relation(fields: [userId], references: [id])
  createdAt     DateTime     @default(now())

  @@map("inventory_movements")
}

model Supplier {
  id        Int        @id @default(autoincrement())
  name      String
  cuit      String?
  phone     String?
  email     String?
  address   String?
  notes     String?    @db.Text
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  purchases Purchase[]

  @@map("suppliers")
}

model BusinessProfile {
  id                    Int                @id @default(autoincrement())
  ownerUserId           Int                @unique
  owner                 User               @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  name                  String
  kind                  BusinessKind       @default(FIJO)
  category              String
  description           String?            @db.Text
  locality              String
  address               String?
  contactPhone          String?
  contactEmail          String?
  notificationsEnabled  Boolean            @default(true)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  applications          EventApplication[]
  sales                 Sale[]
  cashMovements         CashMovement[]

  @@map("business_profiles")
}

model MarketEvent {
  id                 Int                @id @default(autoincrement())
  organizerUserId    Int
  organizer          User               @relation("EventOrganizer", fields: [organizerUserId], references: [id])
  name               String
  locality           String
  address            String?
  latitude           Float?
  longitude          Float?
  startsAt           DateTime
  endsAt             DateTime
  applicationDeadline DateTime
  description        String             @db.Text
  acceptedCategories String?            @db.Text
  requirements       String?            @db.Text
  capacity           Int?
  status             OpportunityStatus  @default(BORRADOR)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  applications       EventApplication[]
  sales              Sale[]
  cashMovements      CashMovement[]

  @@index([status, locality, startsAt])
  @@map("market_events")
}

model EventApplication {
  id                Int               @id @default(autoincrement())
  eventId           Int
  event             MarketEvent       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  businessId        Int
  business          BusinessProfile   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  applicantUserId   Int
  applicant         User              @relation("Applicant", fields: [applicantUserId], references: [id], onDelete: Cascade)
  offeredProduct    String
  additionalInfo    String?           @db.Text
  status            ApplicationStatus @default(BORRADOR)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([eventId, businessId])
  @@index([applicantUserId, status])
  @@map("event_applications")
}

model Purchase {
  id             Int              @id @default(autoincrement())
  purchaseNumber String           @unique
  supplierId     Int
  supplier       Supplier         @relation(fields: [supplierId], references: [id])
  total          Decimal          @db.Decimal(12, 2)
  status         PurchaseStatus   @default(PENDIENTE)
  notes          String?          @db.Text
  userId         Int
  user           User             @relation(fields: [userId], references: [id])
  createdAt      DateTime         @default(now())
  receivedAt     DateTime?
  details        PurchaseDetail[]

  @@map("purchases")
}

model PurchaseDetail {
  id         Int      @id @default(autoincrement())
  purchaseId Int
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  Int
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int
  unitCost   Decimal  @db.Decimal(12, 2)
  subtotal   Decimal  @db.Decimal(12, 2)

  @@map("purchase_details")
}

model Sale {
  id                Int          @id @default(autoincrement())
  saleNumber        String       @unique
  total             Decimal      @db.Decimal(12, 2)
  discount          Decimal      @default(0) @db.Decimal(12, 2)
  paymentMethod     String
  status            SaleStatus   @default(COMPLETADA)
  cancelReason      String?      @db.Text
  cancelledAt       DateTime?
  cancelledByUserId Int?
  cancelledByUser   User?        @relation("CancelledSales", fields: [cancelledByUserId], references: [id])
  userId            Int
  user              User         @relation(fields: [userId], references: [id])
  createdAt         DateTime     @default(now())
  details           SaleDetail[]
  eventId           Int?
  event             MarketEvent?     @relation(fields: [eventId], references: [id], onDelete: SetNull)
  businessId        Int?
  business           BusinessProfile? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@map("sales")
}

model SaleDetail {
  id        Int      @id @default(autoincrement())
  saleId    Int
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal  @db.Decimal(12, 2)
  unitCost  Decimal  @db.Decimal(12, 2)
  subtotal  Decimal  @db.Decimal(12, 2)

  @@map("sale_details")
}

model CashRegister {
  id                Int            @id @default(autoincrement())
  openingUserId     Int
  openingUser       User           @relation("OpenedRegisters", fields: [openingUserId], references: [id])
  closingUserId     Int?
  closingUser       User?          @relation("ClosedRegisters", fields: [closingUserId], references: [id])
  openedAt          DateTime       @default(now())
  closedAt          DateTime?
  initialAmount     Decimal        @db.Decimal(12, 2)
  theoreticalAmount Decimal?       @db.Decimal(12, 2)
  realAmount        Decimal?       @db.Decimal(12, 2)
  difference        Decimal?       @db.Decimal(12, 2)
  status            CashStatus     @default(ABIERTA)
  notes             String?        @db.Text
  movements         CashMovement[]

  @@map("cash_registers")
}

model CashMovement {
  id             Int              @id @default(autoincrement())
  cashRegisterId Int?
  cashRegister   CashRegister?    @relation(fields: [cashRegisterId], references: [id])
  type           CashMovementType
  category       String
  amount         Decimal          @db.Decimal(12, 2)
  concept        String
  userId         Int
  user           User             @relation(fields: [userId], references: [id])
  createdAt      DateTime         @default(now())
  eventId        Int?
  event          MarketEvent?     @relation(fields: [eventId], references: [id], onDelete: SetNull)
  businessId     Int?
  business       BusinessProfile? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@map("cash_movements")
}

model Notification {
  id          Int      @id @default(autoincrement())
  type        String
  title       String
  description String   @db.Text
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  userId      Int?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model BusinessConfig {
  id                 Int     @id @default(autoincrement())
  businessName       String  @default("Mi Comercio - Autogestión")
  cuit               String  @default("20-30123456-7")
  address            String  @default("Av. Principal 1234, CABA")
  phone              String  @default("+54 11 4567-8900")
  email              String  @default("contacto@micomercio.com.ar")
  currencyCode       String  @default("ARS")
  currencySymbol     String  @default("$")
  receiptFooter      String  @default("¡Gracias por su compra! Comprobante interno.")
  allowNegativeStock Boolean @default(false)

  @@map("business_configs")
}

model PaymentMethod {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  active    Boolean  @default(true)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("payment_methods")
}
